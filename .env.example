# ==========================================
# MedusaJS Core Settings
# ==========================================
NODE_ENV=development
PORT=9000
JWT_SECRET=supersecret_jwt_key
COOKIE_SECRET=supersecret_cookie_key

# ==========================================
# Database (Neon Serverless Postgres)
# ==========================================
# Provide your Neon connection string here
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb

# ==========================================
# Cache & Events (Upstash Redis)
# ==========================================
# Provide your Upstash Redis URL
REDIS_URL=rediss://default:password@example.upstash.io:30000

# ==========================================
# Search (Algolia)
# ==========================================
# Provide your Algolia App ID and Admin API Key
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=

# ==========================================
# Payments (Stripe)
# ==========================================
# Provide your Stripe secret key and webhook secret
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ==========================================
# Content (Sanity CMS)
# ==========================================
# Provide your Sanity Project ID and Token
SANITY_PROJECT_ID=
SANITY_API_TOKEN=

# ==========================================
# Storefront CORS
# ==========================================
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001,http://localhost:9000
